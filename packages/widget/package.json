{
  "name": "@supoapp/widget",
  "version": "0.1.0-alpha.4",
  "description": "Official Supo browser widget SDK for React, vanilla TypeScript, and headless chat UI integrations.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "homepage": "https://supo.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TahubCS/Supo.git",
    "directory": "packages/widget"
  },
  "bugs": {
    "url": "https://github.com/TahubCS/Supo/issues"
  },
  "keywords": [
    "supo",
    "support",
    "chat",
    "widget",
    "customer-support",
    "ai-support",
    "react",
    "nextjs",
    "headless"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:legacy": "tsup --config tsup.legacy.config.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run typecheck && bun run build",
    "pack:dry": "npm pack --dry-run --cache C:\\tmp\\npm-cache-supo",
    "release:alpha": "npm publish --access public --tag alpha"
  },
  "dependencies": {
    "ably": "^2.21.0"
  },
  "peerDependencies": {
    "react": ">=18 || >=19",
    "react-dom": ">=18 || >=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
