# Database
DATABASE_URL=
# Set to "disable" for a local Postgres without TLS (or add sslmode=disable to the URL)
DATABASE_SSL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_API_KEY=
# Optional extra origins allowed to use auth, comma-separated exact origins
# (e.g. https://app.example.com). Never use a *.vercel.app wildcard.
BETTER_AUTH_TRUSTED_ORIGINS=

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional GitHub App for connecting repositories to the knowledge base.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# Optional Atlassian OAuth 2.0 (3LO) app for adding Confluence spaces to the knowledge base.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# Encrypts stored integration tokens: 32 random bytes, base64 (openssl rand -base64 32).
INTEGRATIONS_ENCRYPTION_KEY=

# Email
RESEND_API_KEY=
# Optional email channel: domain whose inbound mail Resend forwards to /api/inbound/email,
# and the signing secret of that Resend webhook.
INBOUND_EMAIL_DOMAIN=
RESEND_WEBHOOK_SECRET=
SECURITY_ALERT_FROM_EMAIL=

# AI
GOOGLE_GEMINI_API_KEY=

# Super-admin allowlist
SUPO_SUPER_ADMIN_EMAILS=
BETTER_AUTH_ADMIN_USER_IDS=

# Rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Realtime
ABLY_API_KEY=

# Optional landing-page demo: id of a Supo product whose widget is shown on the home page.
# Read at build time; redeploy after changing it.
NEXT_PUBLIC_SUPO_DEMO_PRODUCT_ID=

# Internal jobs / Vercel Cron (Vercel sends Authorization: Bearer $CRON_SECRET)
CRON_SECRET=
